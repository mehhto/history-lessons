{
  "name": "history-lessons",
  "version": "0.1.0",
  "private": true,
  "description": "Lokalny, offline-first system tworzenia lekcji historii dla klas IV–VIII.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "new": "node scripts/new-lesson.mjs",
    "check": "node scripts/check-lessons.mjs",
    "serve": "node scripts/serve.mjs",
    "preview": "node scripts/preview.mjs",
    "sync:reveal": "node scripts/sync-reveal.mjs",
    "export:pdf": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/export-pdf.mjs",
    "export:print": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/export-print-pack.mjs",
    "check:render": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/render-check.mjs"
  },
  "dependencies": {
    "playwright": "1.62.1",
    "reveal.js": "6.0.1"
  }
}
