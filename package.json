{
  "name": "history-lessons",
  "version": "0.1.0",
  "private": true,
  "description": "Lokalny, offline-first system tworzenia lekcji historii dla klas IV–VIII.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "new": "node scripts/new-lesson.mjs",
    "check": "node scripts/check-lessons.mjs",
    "serve": "node scripts/serve.mjs",
    "preview": "node scripts/preview.mjs",
    "sync:reveal": "node scripts/sync-reveal.mjs",
    "install:browser": "node scripts/with-local-playwright.mjs node_modules/playwright/cli.js install chromium",
    "export:pdf": "node scripts/with-local-playwright.mjs scripts/export-pdf.mjs",
    "export:portable": "node scripts/export-portable.mjs",
    "export:print": "node scripts/with-local-playwright.mjs scripts/export-print-pack.mjs",
    "check:render": "node scripts/with-local-playwright.mjs scripts/render-check.mjs",
    "check:render:all": "node scripts/with-local-playwright.mjs scripts/check-all-renders.mjs",
    "check:composition": "node scripts/check-slide-composition.mjs",
    "review:slides": "node scripts/with-local-playwright.mjs scripts/review-slides.mjs"
  },
  "dependencies": {
    "playwright": "1.62.1",
    "reveal.js": "6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "marked": "^18.0.12",
    "parse5": "^8.0.1",
    "postcss": "^8.5.28",
    "postcss-value-parser": "^4.2.0"
  }
}
